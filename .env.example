# Local regtest only. These values are not secrets; do not put a mainnet RPC password here.

# Coordinator. HOST stays on loopback outside a container. Compose sets 0.0.0.0 inside the container.
PORT=8787
HOST=127.0.0.1
KOINON_DB=data/koinon.sqlite
LOG_LEVEL=info

# Bitcoin Core on the local regtest network. Compose does not publish this port.
# This URL is for a bitcoind already running on the host. The sample user and password are not a mainnet secret.
BITCOIN_RPC_URL=http://127.0.0.1:18445
BITCOIN_RPC_USER=koinon
BITCOIN_RPC_PASSWORD=koinon

# Live BTC/EUR. XOF is that price times the fixed 655.957 peg. Never hard-code a fallback.
MEMPOOL_PRICES_URL=https://mempool.space/api/v1/prices

# CLI. Keys stay in KOINON_HOME. The pin is local and is not sent to the coordinator.
KOINON_HOME=.koinon
KOINON_PIN=
KOINON_COORDINATOR=http://127.0.0.1:8787
KOINON_RELAY=ws://127.0.0.1:8080
BITCOIN_RPC_WALLET=bootstrap

# Demo stack only. The coordinator never reads these. FIXTURE_EUR is the price server, not a fallback.
# KOINON_RATE_SOURCE=fixture
# FIXTURE_EUR=60000
# KOINON_LOG=.e2e/coordinator.log
# KOINON_SCAN_WORD=.e2e/word
